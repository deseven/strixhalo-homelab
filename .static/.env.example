# GitHub repo hosting the wiki: `user/repo` or `user/repo/branch`.
# Raw attachment links and GitHub page links are generated from it.
GH_REPO=deseven/strixhalo-homelab

# Generate clean (extension-less) internal links. When 'true', pages are still
# emitted as `key.html` but every link drops the `.html` suffix (e.g.
# `Hardware/PCs/Abee_AI_Station`), so a webserver rule must map extension-less
# paths onto the `.html` files. The wiki entry point is always `index.html`.
# Anything other than 'true' keeps `.html` in the links.
#CLEAN_URLS=false